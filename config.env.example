# Copy to config.env and fill in. Keep it out of git, it holds your access token.

# Matrix homeserver URL (client API endpoint).
MATRIX_URL=https://matrix.example.org
# The bot's Matrix user.
MATRIX_USER_ID=@jellyseerr-bot:example.org
# Access token + device ID from the login call, see docs/setup.md.
MATRIX_TOKEN=syt_...
MATRIX_DEVICE_ID=ABCDEFGHIJ
# Room the bot posts to. Invite the bot, it joins on its own.
MATRIX_ROOM_ID=!yourroomid:example.org
# Shared secret. Set the same value as the Authorization header in the Jellyseerr webhook.
WEBHOOK_SECRET=long-random-secret
# Jellyseerr username -> Matrix ID, used for pings. Unknown names appear as plain text.
USER_MAP={"frodo":"@frodo:example.org","dude":"@dude:example.org"}
# Operator team, comma-separated. Pinged on MEDIA_PENDING, ISSUE_CREATED and ISSUE_REOPENED.
ADMIN_IDS=@gandalf:example.org
# Base URL of your Jellyseerr, used for title and reply links. Empty: plain text titles.
JELLYSEERR_URL=https://jellyseerr.example.org
# Bot language: en or de. Default: en.
BOT_LANG=en
